#!/usr/bin/env bash
# backup-rotation - tar/rsync backups with GFS (daily/weekly/monthly) retention,
# SHA-256 checksums, dry-run mode, lockfile and logging.
set -euo pipefail
umask 077

readonly VERSION="1.0.0"
readonly PROG="${0##*/}"

# ---- defaults -------------------------------------------------------------
MODE="tar"            # tar | rsync
DEST=""
PREFIX="backup"
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12
WEEKLY_DAY=7          # ISO day of week for weekly backups (7 = Sunday)
DRY_RUN=0
LOG_FILE=""
LOCK_FILE=""
VERIFY_ONLY=0
SOURCES=()
EXCLUDES=()
SHOW_BANNER=1

# ---- banner (cosmetic: stderr only, interactive terminals only) -----------
# Bastion Ops Toolkit banner. Disable with --no-banner or NO_BANNER=1. Not shown when
# stderr is not a terminal (cron, pipes, systemd, monitoring agents).
banner_enabled() {
  (( SHOW_BANNER )) || return 1
  [[ -z ${NO_BANNER:-} || ${NO_BANNER} == 0 ]] || return 1
  [[ -t 2 ]]
}

print_banner() {
  banner_enabled || return 0
  {
    cat <<'WORDMARK'
   _             _                         _        _   _
  | |__  __ _ __| |___  _ _ __ ___ _ _ ___| |_ __ _| |_(_)___ _ _
  | '_ \/ _` / _| / / || | '_ \___| '_/ _ \  _/ _` |  _| / _ \ ' \
  |_.__/\__,_\__|_\_\\_,_| .__/   |_| \___/\__\__,_|\__|_\___/_||_|
                         |_|

+====================================================================+
|  BACKUP ROTATION  ::  GFS Backup & Retention Manager               |
+--------------------------------------------------------------------+
|  Verified tar/rsync backups with daily/weekly/monthly retention    |
WORDMARK
    printf '|  %-64s  |\n' "v$VERSION  -  Bastion Ops Toolkit  -  by int3erlud3"
    printf '%s\n\n' '+====================================================================+'
  } >&2 || true
}

usage() {
  cat <<USAGE
Usage: $PROG -d DEST -s SOURCE [-s SOURCE ...] [options]
       $PROG -d DEST --verify

  -s, --source PATH        Absolute path to back up (repeatable)
  -d, --dest DIR           Backup repository directory (must exist)
  -m, --mode tar|rsync     tar.gz archive or rsync hard-link snapshot (default: tar)
  -e, --exclude PATTERN    Exclude pattern passed to tar/rsync (repeatable)
  -p, --prefix NAME        Backup name prefix (default: backup)
      --keep-daily N       Daily backups to keep (default: 7)
      --keep-weekly N      Weekly backups to keep (default: 4)
      --keep-monthly N     Monthly backups to keep (default: 12)
      --weekly-day N       ISO weekday for weekly backups, 1=Mon..7=Sun (default: 7)
  -n, --dry-run            Show what would be done, change nothing
  -l, --log-file FILE      Append log lines to FILE
      --lock-file FILE     Lock file (default: DEST/.backup-rotation.lock)
      --verify             Verify checksums of all backups in DEST and exit
      --no-banner          Do not print the startup banner (or NO_BANNER=1)
  -h, --help | -V, --version
USAGE
}

log() {
  local line
  line="$(date '+%Y-%m-%dT%H:%M:%S%z') [$1] ${*:2}"
  printf '%s\n' "$line" >&2
  if [[ -n $LOG_FILE ]]; then printf '%s\n' "$line" >>"$LOG_FILE"; fi
}
die() { log ERROR "$*"; exit 1; }

# Execute a command (argument list, never a shell string) or print it in dry-run.
run() {
  if (( DRY_RUN )); then log DRY-RUN "$(printf '%q ' "$@")"; return 0; fi
  "$@"
}

need_uint() { [[ $2 =~ ^[0-9]{1,4}$ ]] || die "$1 must be a non-negative integer (got '$2')"; }

parse_args() {
  while (( $# )); do
    case $1 in
      -h|--help) print_banner; usage; exit 0 ;;
      -V|--version) print_banner; echo "$PROG $VERSION"; exit 0 ;;
      -n|--dry-run) DRY_RUN=1; shift; continue ;;
      --no-banner) shift; continue ;;
      --verify) VERIFY_ONLY=1; shift; continue ;;
    esac
    [[ $# -ge 2 ]] || { usage >&2; die "missing value for '$1'"; }
    case $1 in
      -s|--source) SOURCES+=("$2") ;;
      -d|--dest) DEST=$2 ;;
      -m|--mode) MODE=$2 ;;
      -e|--exclude) EXCLUDES+=("$2") ;;
      -p|--prefix) PREFIX=$2 ;;
      --keep-daily) need_uint "$1" "$2"; KEEP_DAILY=$((10#$2)) ;;
      --keep-weekly) need_uint "$1" "$2"; KEEP_WEEKLY=$((10#$2)) ;;
      --keep-monthly) need_uint "$1" "$2"; KEEP_MONTHLY=$((10#$2)) ;;
      --weekly-day) [[ $2 =~ ^[1-7]$ ]] || die "--weekly-day must be 1-7"; WEEKLY_DAY=$2 ;;
      -l|--log-file) LOG_FILE=$2 ;;
      --lock-file) LOCK_FILE=$2 ;;
      *) usage >&2; die "unknown argument '$1'" ;;
    esac
    shift 2
  done
}

validate() {
  local src
  [[ -n $DEST ]] || die "--dest is required"
  [[ $DEST == /* ]] || die "--dest must be an absolute path"
  [[ -d $DEST ]] || die "destination '$DEST' does not exist (create it with restrictive permissions first)"
  DEST=$(cd -- "$DEST" && pwd -P)
  [[ $PREFIX =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "invalid prefix '$PREFIX'"
  (( VERIFY_ONLY )) && return 0
  [[ $MODE == tar || $MODE == rsync ]] || die "--mode must be tar or rsync"
  (( ${#SOURCES[@]} > 0 )) || die "at least one --source is required"
  for src in "${SOURCES[@]}"; do
    [[ $src == /* ]] || die "source must be an absolute path: '$src'"
    [[ -e $src ]] || die "source does not exist: '$src'"
    src=$(realpath -e -- "$src")
    [[ $src == "$DEST" || $src/ == "$DEST"/* || $DEST/ == "$src"/* ]] \
      && die "source '$src' and destination overlap"
  done
  if [[ $MODE == rsync ]]; then
    command -v rsync >/dev/null || die "rsync not installed"
    (( ${#SOURCES[@]} == 1 )) || die "rsync mode supports exactly one --source"
  fi
}

# GFS tier for a date: first of month -> monthly, WEEKLY_DAY -> weekly, else daily.
# BACKUP_DATE (YYYY-MM-DD) may be set to override "today" (used by tests).
determine_tier() {
  local day dom dow
  day=${BACKUP_DATE:-$(date +%F)}
  [[ $day =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "invalid BACKUP_DATE '$day'"
  dom=$(date -d "$day" +%d) dow=$(date -d "$day" +%u)
  if [[ $dom == 01 ]]; then echo monthly
  elif [[ $dow == "$WEEKLY_DAY" ]]; then echo weekly
  else echo daily; fi
}

acquire_lock() {
  local lock=${LOCK_FILE:-$DEST/.backup-rotation.lock}
  exec 9>>"$lock" || die "cannot open lock file '$lock'"
  flock -n 9 || die "another backup is running (lock: $lock)"
}

create_backup() {
  local tier=$1 stamp name dir tmp src ex
  local -a rel=() excl=()
  if [[ -n ${BACKUP_DATE:-} ]]; then
    stamp=$(date -d "$BACKUP_DATE $(date +%T)" +%Y%m%d-%H%M%S)
  else
    stamp=$(date +%Y%m%d-%H%M%S)
  fi
  name="$PREFIX-$tier-$stamp"
  dir="$DEST/$tier"
  [[ -e $dir/$name || -e $dir/$name.tar.gz ]] && die "backup '$name' already exists"
  for ex in "${EXCLUDES[@]+"${EXCLUDES[@]}"}"; do excl+=("--exclude=$ex"); done
  run mkdir -p -- "$dir"

  if [[ $MODE == tar ]]; then
    for src in "${SOURCES[@]}"; do
      src=$(realpath -e -- "$src"); src=${src#/}
      rel+=("${src:-.}")
    done
    tmp="$dir/.$name.tar.gz.partial"
    log INFO "creating archive $dir/$name.tar.gz"
    run tar --create --gzip --file "$tmp" --directory / "${excl[@]+"${excl[@]}"}" -- "${rel[@]}"
    run mv -- "$tmp" "$dir/$name.tar.gz"
    if (( ! DRY_RUN )); then
      (cd -- "$dir" && sha256sum -- "$name.tar.gz" >"$name.tar.gz.sha256")
    fi
  else
    local latest
    local -a linkdest=()
    # Newest existing snapshot of any tier (sorted by timestamp) for hard links.
    latest=$(find "$DEST" -mindepth 2 -maxdepth 2 -type d -name "$PREFIX-*-[0-9]*-[0-9]*" -printf '%f\t%p\n' \
      | awk -F'\t' '{ print substr($1, length($1) - 14) "\t" $2 }' | sort | tail -n 1 | cut -f2)
    [[ -n $latest ]] && linkdest=("--link-dest=$latest")
    tmp="$dir/.$name.partial"
    log INFO "creating snapshot $dir/$name${latest:+ (hard links against ${latest##*/})}"
    run rsync -a --delete --numeric-ids "${linkdest[@]+"${linkdest[@]}"}" \
      "${excl[@]+"${excl[@]}"}" -- "$(realpath -e -- "${SOURCES[0]}")/" "$tmp/"
    run mv -- "$tmp" "$dir/$name"
    if (( ! DRY_RUN )); then
      (cd -- "$dir/$name" && find . -type f -print0 | sort -z | xargs -0 -r sha256sum --) \
        >"$dir/$name.sha256"
    fi
  fi
  log INFO "backup complete: $name"
}

# Delete backups beyond the retention count. Only names that match the strict
# backup pattern are ever touched.
rotate_tier() {
  local tier=$1 keep=$2 dir=$DEST/$1 entry n=0
  local re="^${PREFIX//./\\.}-$tier-[0-9]{8}-[0-9]{6}(\\.tar\\.gz)?\$"
  [[ -d $dir ]] || return 0
  while IFS= read -r entry; do
    [[ $entry =~ $re ]] || continue
    n=$((n + 1))
    (( n <= keep )) && continue
    log INFO "retention ($tier, keep $keep): removing $entry"
    run rm -rf -- "${dir:?}/$entry"
    run rm -f -- "$dir/$entry.sha256"
  done < <(find "$dir" -mindepth 1 -maxdepth 1 ! -name '.*' ! -name '*.sha256' -printf '%f\n' | sort -r)
}

verify_all() {
  local sum base dir failed=0 checked=0
  while IFS= read -r sum; do
    dir=${sum%/*} base=${sum##*/}; base=${base%.sha256}
    checked=$((checked + 1))
    if [[ -d $dir/$base ]]; then
      (cd -- "$dir/$base" && sha256sum --quiet --strict -c -- "$sum") || failed=$((failed + 1))
    else
      (cd -- "$dir" && sha256sum --quiet --strict -c -- "$sum") || failed=$((failed + 1))
    fi
  done < <(find "$DEST" -mindepth 2 -maxdepth 2 -type f -name "$PREFIX-*.sha256" | sort)
  log INFO "verified $checked backup(s), $failed failure(s)"
  (( failed == 0 ))
}

main() {
  local arg
  for arg in "$@"; do
    if [[ $arg == --no-banner ]]; then SHOW_BANNER=0; fi
  done
  parse_args "$@"
  validate
  print_banner
  if [[ -n $LOG_FILE ]]; then touch -- "$LOG_FILE" || die "cannot write log file '$LOG_FILE'"; fi
  if (( VERIFY_ONLY )); then verify_all; exit; fi
  if (( DRY_RUN )); then log INFO "dry-run mode: no changes will be made"; else acquire_lock; fi
  local tier
  tier=$(determine_tier)
  log INFO "starting $MODE backup (tier: $tier) to $DEST"
  create_backup "$tier"
  rotate_tier daily "$KEEP_DAILY"
  rotate_tier weekly "$KEEP_WEEKLY"
  rotate_tier monthly "$KEEP_MONTHLY"
  log INFO "done"
}

main "$@"
